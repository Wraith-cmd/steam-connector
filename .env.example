# Copy this file to .env for local development. Never commit real values.

# Your Steam Web API key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your-steam-api-key-here

# Your 17-digit SteamID64 (starts with 7656119). Used when no profile is given.
STEAM_ID=76561197960287930

# A long random string that becomes part of your connector URL.
# Generate one with: openssl rand -hex 32
MCP_SECRET=replace-me-with-a-long-random-string

# Optional: two-letter country code used for store prices (default: us)
# STEAM_COUNTRY=us
